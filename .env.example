# Copy this file to .env and fill in real values. .env is gitignored.

ENVIRONMENT=development

# Local Postgres created for Phase 0 (see README): `createdb gghightech_dev`.
# Must be a plain, non-superuser role: Postgres superusers unconditionally
# bypass Row Level Security (see the "enable row level security" migration
# and app/services/auth.py's _apply_rls_context) regardless of FORCE ROW
# LEVEL SECURITY, so connecting as one makes those policies silently inert.
# Local dev setup (once, as a superuser):
#   psql gghightech_dev -c "CREATE ROLE gghightech_app WITH LOGIN PASSWORD '...';"
#   psql gghightech_dev -c "GRANT CONNECT ON DATABASE gghightech_dev TO gghightech_app;"
#   psql gghightech_dev -c "GRANT USAGE, CREATE ON SCHEMA public TO gghightech_app;"
#   -- then ALTER TABLE <each table> OWNER TO gghightech_app; (so it can run migrations)
DATABASE_URL=postgresql+psycopg2://gghightech_app:CHANGE_ME@localhost/gghightech_dev

CORS_ORIGINS=["http://localhost:3000"]

# The frontend's own origin — used to build links that get emailed out,
# e.g. the invite-accept link in app/api/routes/users.py. Set this to the
# real deployed frontend URL in production.
FRONTEND_URL=http://localhost:3000

# --- Local login (app/services/local_auth.py) — the site's only auth ---
# Leave blank to use the X-Dev-User-Role dev-auth fallback instead
# (development only — see app/services/auth.py). Required for POST
# /auth/login and POST /auth/accept-invite to work at all; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Then create the first account with:
#   python -m app.cli create-superadmin --email you@example.com --password '...' --full-name "Your Name"
SECRET_KEY=

# --- Email (lead notifications + invite links, stubbed until Phase 2 — see app/services/email.py) ---
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=leads@gghightech.example
