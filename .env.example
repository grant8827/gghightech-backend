# Copy this file to .env and fill in real values. .env is gitignored.

# --- Environment (security-sensitive) ---
# If ENVIRONMENT is omitted or blank, the app assumes "production". That is
# deliberate: forgetting this variable must never loosen security.
#   production  (the default) and any value other than "development":
#               SECRET_KEY is mandatory and must be strong, or the app, Alembic
#               and the CLI refuse to start. Dev-header auth is impossible.
#   development local work only. SECRET_KEY may be blank (login then returns
#               503). Dev-header auth is still OFF unless opted into below.
# This file is a template for LOCAL development, so it sets "development".
# Real deployments should set ENVIRONMENT=production explicitly.
ENVIRONMENT=development

# Opt-in for the X-Dev-User-Role / X-Dev-User-Email auth shortcut, which lets
# any caller claim any role with no password. Off by default. Only honoured
# when ENVIRONMENT=development; setting it to true in any other environment
# makes the app refuse to start. NEVER set this on a deployed server. The
# frontend does not need it (it logs in with a real account).
ALLOW_DEV_AUTH_HEADERS=false

# Local Postgres created for Phase 0 (see README): `createdb gghightech_dev`.
# Must be a plain, non-superuser role: Postgres superusers unconditionally
# bypass Row Level Security (see the "enable row level security" migration
# and app/services/auth.py's _apply_rls_context) regardless of FORCE ROW
# LEVEL SECURITY, so connecting as one makes those policies silently inert.
# Local dev setup (once, as a superuser):
#   psql gghightech_dev -c "CREATE ROLE gghightech_app WITH LOGIN PASSWORD '...';"
#   psql gghightech_dev -c "GRANT CONNECT ON DATABASE gghightech_dev TO gghightech_app;"
#   psql gghightech_dev -c "GRANT USAGE, CREATE ON SCHEMA public TO gghightech_app;"
#   -- then ALTER TABLE <each table> OWNER TO gghightech_app; (so it can run migrations)
DATABASE_URL=postgresql+psycopg2://gghightech_app:CHANGE_ME@localhost/gghightech_dev

CORS_ORIGINS=["http://localhost:3000"]

# The frontend's own origin — used to build links that get emailed out,
# e.g. the invite-accept link in app/api/routes/users.py. Set this to the
# real deployed frontend URL in production.
FRONTEND_URL=http://localhost:3000

# --- Local login (app/services/local_auth.py) — the site's only auth ---
# Signs every login session. Required for POST /auth/login and POST
# /auth/accept-invite to work at all, and REQUIRED OUTSIDE DEVELOPMENT: the
# app will not start unless it is at least 32 characters and not a
# placeholder. Generate a unique value per environment and never commit it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and invalidates outstanding invite links.
# Then create the first account with:
#   python -m app.cli create-superadmin --email you@example.com --password '...' --full-name "Your Name"
SECRET_KEY=

# --- Email (Mailgun) — app/services/email.py ---
# Sends invite links, payment links, and new-lead notifications. Sending is
# ON only when both MAILGUN_API_KEY and MAILGUN_DOMAIN are set.
# Without them:
#   - ENVIRONMENT=development: nothing is sent; the full email (including
#     its link) is printed to the console so you can still work locally.
#   - any other environment: nothing is sent and nothing sensitive is
#     logged, so INVITED USERS CANNOT GET THEIR LINK. Configure this before
#     inviting anyone in production.
# The key is a secret: set it in your host's environment, never commit it.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Use https://api.eu.mailgun.net if the sending domain is in Mailgun's EU region.
MAILGUN_API_BASE=https://api.mailgun.net
# Optional. Defaults to: GG HighTech <no-reply@MAILGUN_DOMAIN>
MAILGUN_FROM_EMAIL=
# Inbox that receives a notification for each new estimate that includes
# contact details. Must be a real address you read.
LEAD_NOTIFICATION_EMAIL=leads@gghightech.example

# --- Billing (invoice payment, stubbed — see app/services/stripe_service.py) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/portal?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/portal?payment=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/portal

# --- AI-assisted estimate analysis (optional) ---
# Uses the Responses API with Structured Outputs. Without a key, estimates
# still work using deterministic scope and infrastructure rules.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Abuse protection for the public estimate form ---
# The estimate endpoints need no login, so they are rate limited per IP
# address and the paid AI call is rationed globally. The values below are the
# built-in defaults; you only need to set a variable to change it.
# Per IP address. Over a limit the API answers 429. 0 disables that limit.
ESTIMATE_CREATE_LIMIT_PER_10_MIN=10
ESTIMATE_CREATE_LIMIT_PER_DAY=40
ESTIMATE_PREVIEW_LIMIT_PER_MIN=60
# Across ALL visitors. Over either one, estimates still work but use the
# built-in pricing rules instead of AI. The daily cap is what bounds the
# OpenAI bill: worst case is roughly this many AI calls per day. It is held
# in memory and resets on restart, so ALSO set a hard monthly spend limit on
# the key in the OpenAI dashboard. 0 turns AI analysis off.
AI_ANALYSIS_DAILY_CAP=200
AI_ANALYSIS_MAX_CONCURRENT=4

# --- Client reviews (public form on the website) ---
# Reviews are accepted without email verification. With true (the default) a
# new review appears on the site immediately and you moderate afterwards
# from the admin Reviews tab. Set to false to hold every new review until
# you publish it — the switch to flip if spam starts getting through.
REVIEWS_AUTO_PUBLISH=true
# Review submissions allowed per IP address. 0 disables that limit.
REVIEW_SUBMIT_LIMIT_PER_HOUR=3
REVIEW_SUBMIT_LIMIT_PER_DAY=10

# --- Brute-force protection for sign-in ---
# Built-in defaults shown; set a variable only to change it. 0 disables one.
# Sign-in attempts allowed per IP address, successful or not:
LOGIN_ATTEMPTS_PER_IP_PER_5_MIN=20
# Wrong passwords for one email from one IP address before that combination
# is locked out. While locked, even the correct password is refused.
LOGIN_FAILURES_BEFORE_LOCKOUT=5
# Wrong passwords for one email from ALL addresses combined before the
# account is locked for everyone. Covers attackers who spread guesses across
# many addresses. Lower = safer against guessing, but easier for someone to
# lock a real user out on purpose.
LOGIN_FAILURES_BEFORE_ACCOUNT_LOCKOUT=20
# How far back failures are counted, and so how long a lockout lasts.
LOGIN_LOCKOUT_MINUTES=15
# Counters are in memory: restarting the API clears every lockout. Failed
# attempts and lockouts are recorded in the audit log.

# Number of reverse proxies / load balancers in front of this API, used to
# find the visitor's real IP for the limits above.
#   0 = ignore X-Forwarded-For (correct for local dev, or when the API is
#       reachable directly). This is the default.
#   1 = one proxy in front, which is typical for managed hosting platforms.
# IMPORTANT in production: if the API is behind a proxy and this stays 0,
# every visitor appears to come from the proxy and shares ONE bucket, so the
# per-IP limits above become site-wide limits. If it is set higher than the
# real number of proxies, visitors can fake their IP and dodge the limits.
TRUSTED_PROXY_HOPS=0

# --- GitHub sync (app/services/github_service.py) ---
# Optional: unauthenticated calls already work for public repos. Set a
# fine-grained PAT (read-only "Contents") for private repos / a higher
# rate limit.
GITHUB_TOKEN=

# --- Jira sync (app/services/jira_service.py) ---
# All three required — Jira needs auth for every call. JIRA_BASE_URL is
# your site, e.g. https://your-team.atlassian.net. Create JIRA_API_TOKEN
# at id.atlassian.com/manage-profile/security/api-tokens.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
