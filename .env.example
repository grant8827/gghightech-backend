# Copy this file to .env and fill in real values. .env is gitignored.

ENVIRONMENT=development

# Local Postgres created for Phase 0 (see README): `createdb gghightech_dev`
DATABASE_URL=postgresql+psycopg2://localhost/gghightech_dev

CORS_ORIGINS=["http://localhost:3000"]

# --- Clerk (auth) ---
# Leave blank to use the X-Dev-User-Role dev-auth fallback (development only —
# see app/services/auth.py). Fill in once the Clerk account exists:
#   CLERK_JWKS_URL   = https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
#   CLERK_ISSUER     = https://<your-instance>.clerk.accounts.dev
#   CLERK_SECRET_KEY = sk_test_...  (needed for server-side calls like inviting users)
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_SECRET_KEY=

# --- Local staff login (app/services/local_auth.py) ---
# Real email/password login used until Clerk replaces it — checked first
# in app/services/auth.py. Required for POST /auth/login to work at all;
# generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Then create the first account with:
#   python -m app.cli create-superadmin --email you@example.com --password '...' --full-name "Your Name"
SECRET_KEY=

# --- Email (stubbed until Phase 2, see app/services/email.py) ---
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=leads@gghightech.example
